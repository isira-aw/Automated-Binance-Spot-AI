# =============================================================================
# Automated Binance Spot AI — environment template
# Copy to `.env` and fill in.  `.env` is gitignored and must NEVER be committed.
# =============================================================================

# ---- Environment ----------------------------------------------------------
# development | testing | paper | production
APP_ENV=development
LOG_LEVEL=INFO

# ---- Binance (Tier 1) -----------------------------------------------------
# Create keys with READ + SPOT TRADING only.  NEVER enable withdrawals.
# See docs/BINANCE_SETUP.md
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ---- Trading safety -------------------------------------------------------
# Live trading additionally requires an explicit ARM action in the UI.
LIVE_TRADING_ENABLED=false
TRADING_MODE=PAPER

# ---- Database -------------------------------------------------------------
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=binance_spot_ai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- API / CORS -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated explicit allow-list.  Never "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Tier 2 (optional intelligence layer; disabled by default) ------------
CLAUDE_API_KEY=
CLAUDE_ENABLED=false
CLAUDE_MAX_CALLS_PER_DAY=50

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_ENABLED=false
OLLAMA_TIMEOUT_SECONDS=8

NEWS_ENABLED=false
